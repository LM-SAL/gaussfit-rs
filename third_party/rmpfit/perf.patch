 #[cfg(test)]
 mod tests {
+    #[test]
+    fn enorm_fast_path_is_bit_identical_to_the_scaled_sum() {
+        use super::{ENorm, MP_RDWARF, MP_RGIANT};
+        let mut state = 0x9e37_79b9_7f4a_7c15_u64;
+        let mut next = || {
+            state ^= state << 13;
+            state ^= state >> 7;
+            state ^= state << 17;
+            state
+        };
+        let specials = [
+            0.0,
+            -0.0,
+            1.0,
+            -3.5,
+            MP_RDWARF,
+            MP_RDWARF * 0.5,
+            MP_RDWARF * 2.0,
+            MP_RGIANT,
+            MP_RGIANT * 0.5,
+            MP_RGIANT / 3.0,
+            1e-200,
+            1e200,
+            f64::MAX,
+            f64::MIN_POSITIVE,
+            f64::INFINITY,
+            f64::NEG_INFINITY,
+            f64::NAN,
+        ];
+        for len in 0..8 {
+            for _ in 0..2000 {
+                let v: Vec<f64> = (0..len)
+                    .map(|_| {
+                        let r = next();
+                        if r % 4 == 0 {
+                            specials[(r >> 8) as usize % specials.len()]
+                        } else {
+                            let mantissa = (r >> 11) as f64 / (1u64 << 53) as f64;
+                            let exponent = ((r >> 3) % 80) as i32 - 40;
+                            (2.0 * mantissa - 1.0) * 10f64.powi(exponent)
+                        }
+                    })
+                    .collect();
+                let fast = v.enorm();
+                let slow = super::enorm_scaled(&v);
+                assert!(
+                    fast.to_bits() == slow.to_bits() || (fast.is_nan() && slow.is_nan()),
+                    "{v:?}: {fast:e} vs {slow:e}"
+                );
+            }
+        }
+    }
